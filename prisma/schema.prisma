generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model SiteSettings {
  id             String   @id @default("main")
  siteTitle      String   @default("Rajat Raj Shah")
  tagline        String   @default("Designer. Developer. Problem solver.")
  logoUrl        String?
  profileUrl     String?
  seoTitle       String?
  seoDescription String?
  primaryColor   String   @default("#c9fa59")
  backgroundColor String @default("#101014")
  navText        String   @default("Let's build something meaningful.")
  footerText     String   @default("Designed with intent. Built with care.")
  contactEmail   String?
  contactLocation String?
  updatedAt      DateTime @updatedAt
}

model PageContent {
  id        String   @id @default(cuid())
  page      String
  section   String
  content   Json
  updatedAt DateTime @updatedAt
  @@unique([page, section])
}

model Skill {
  id String @id @default(cuid())
  name String
  category String @default("Development")
  level Int @default(80)
  sortOrder Int @default(0)
}
model Experience {
  id String @id @default(cuid())
  role String
  company String
  description String @db.Text
  startDate String
  endDate String?
  sortOrder Int @default(0)
}
model Education {
  id String @id @default(cuid())
  institution String
  qualification String
  description String? @db.Text
  startDate String?
  endDate String?
  sortOrder Int @default(0)
}
model Project {
  id String @id @default(cuid())
  title String
  slug String @unique
  description String @db.Text
  imageUrl String?
  tags String[] @default([])
  url String?
  featured Boolean @default(false)
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Certificate {
  id String @id @default(cuid())
  title String
  issuer String
  date String
  imageUrl String?
  url String?
  sortOrder Int @default(0)
}
model Service {
  id String @id @default(cuid())
  title String
  description String @db.Text
  icon String?
  imageUrl String?
  sampleUrl String?
  sortOrder Int @default(0)
}
model BlogPost {
  id String @id @default(cuid())
  title String
  slug String @unique
  excerpt String @db.Text
  content String @db.Text
  coverUrl String?
  category String @default("Insights")
  status String @default("DRAFT")
  pinned Boolean @default(false)
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, publishedAt])
}
model SocialLink {
  id String @id @default(cuid())
  label String
  url String
  icon String @default("globe")
  sortOrder Int @default(0)
}
model AdminUser {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  createdAt DateTime @default(now())
}
