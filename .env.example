# Neon: use pooled URL for DATABASE_URL and direct URL for migrations if available
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Cloudinary dashboard -> Settings -> Product environment credentials
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Web3Forms: https://web3forms.com/
WEB3FORMS_ACCESS_KEY=""

# Use a long random value (e.g. openssl rand -base64 32)
AUTH_SECRET=""
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-to-a-long-unique-password"

# Public URL, used for canonical metadata and sitemap
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Required by the browser contact form (same Web3Forms access key)
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=""
